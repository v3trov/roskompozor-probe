#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
USE_PROCD=1
START=98
STOP=10
start_service() {
    [ -s /etc/roskompozor-probe-next/config.json ] || return 1
    # ZeroBlock's documented runtime chain must still recognize the bypass bit.
    if /etc/init.d/zeroblock running 2>/dev/null; then
        nft list chain inet zeroblock mangle_output 2>/dev/null | grep -q '0x40000000' || {
            logger -t roskompozor-probe-next 'Direct route is unavailable; refusing proxied measurements'
            return 1
        }
    fi
    procd_open_instance
    procd_set_param command /usr/bin/python3 /opt/roskompozor-probe-next/next/probe_next.py /etc/roskompozor-probe-next/config.json
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 ROSKOMPOZOR_DIRECT_DNS=1 ROSKOMPOZOR_SOCKET_MARK=0x48000000
    procd_set_param respawn 3600 10 5
    procd_set_param nice 10
    procd_set_param term_timeout 15
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() { stop; start; }
